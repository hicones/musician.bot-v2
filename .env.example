# Obrigatório - Token do Bot do Discord
DISCORD_TOKEN=seu_token_aqui

# Obrigatório - IDs dos Usuários Administradores (separados por vírgula)
ADMIN_USER_IDS=id1,id2,id3

# Opcional - Configurações do Lavalink (se rodando fora do docker-compose padrão)
LAVALINK_HOST=127.0.0.1:2333
LAVALINK_PASSWORD=youshallnotpass
LAVALINK_SECURE=false

# Opcional - YouTube OAuth Refresh Token (para evitar bloqueios de bots do YouTube)
YOUTUBE_REFRESH_TOKEN=

# Opcional - Credenciais do Spotify para o plugin LavaSrc do Lavalink
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Opcional - Caminhos locais
DATABASE_PATH=./data/database.sqlite
BANNER_PATH=./assets/banner.png
PLACEHOLDER_PATH=./assets/placeholder.png
